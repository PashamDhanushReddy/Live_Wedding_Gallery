# ==============================================================================
# Live Wedding Gallery - Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Replace all placeholder values with your verified production credentials.
# 3. NEVER commit the real .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO & RUNTIME SECURITY
# ------------------------------------------------------------------------------
# In production, DEBUG MUST ALWAYS be false. (Enables HSTS, secure cookies, SSL redirect)
DEBUG=false

# 50+ character cryptographically secure secret key (e.g. openssl rand -base64 48)
SECRET_KEY=change-to-a-cryptographically-secure-random-string-in-production

# Comma-separated allowed hostnames or automatically inferred from RENDER_EXTERNAL_HOSTNAME
ALLOWED_HOSTS=live-wedding-gallery.onrender.com,localhost,127.0.0.1
RENDER_EXTERNAL_HOSTNAME=live-wedding-gallery.onrender.com

# Enable structured JSON logging for Datadog / Render log streaming
USE_JSON_LOGGING=true

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE (WITH PGBOUNCER & PGVECTOR)
# ------------------------------------------------------------------------------
# Neon connection string (MUST use the -pooler endpoint and sslmode=require for production PgBouncer)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-your-pooler-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. REDIS BROKER & CACHE (RENDER REDIS / UPSTASH)
# ------------------------------------------------------------------------------
# Redis connection URL for Celery message broker and Django Channels ASGI layer
# In Render private networking: redis://live-wedding-redis:6379
# Over public TLS: rediss://default:YOUR_PASSWORD@your-host.render.com:6379
REDIS_URL=redis://localhost:6379/0

# Toggle Redis-backed caching and Django Channels layer
USE_REDIS_CACHE=true
USE_REDIS_CHANNEL_LAYER=true

# ------------------------------------------------------------------------------
# 4. CLOUDINARY CDN & OBJECT STORAGE (SINGLE ACCOUNT ARCHITECTURE)
# ------------------------------------------------------------------------------
# All wedding photos are uploaded to folders partitioned by wedding slug:
# weddings/<wedding_slug>/<folder>/<YYYY-MM-DD>/<checksum>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Free Tier Capacity Target: ~750 KB per photo, 2560px Quad-HD (fits 10k-20k photos in 25 credits)
CLOUDINARY_MAX_STORAGE_KB=750
CLOUDINARY_MAX_DIMENSION=2560

# Optional mock mode for local unit tests without live internet/Cloudinary access
MOCK_CLOUDINARY=false

# ------------------------------------------------------------------------------
# 5. FACE RECOGNITION & BIOMETRICS (INSIGHTFACE & PGVECTOR)
# ------------------------------------------------------------------------------
# InsightFace ONNX model pack: buffalo_sc (lightweight, ~50MB) or buffalo_l (~300MB)
FACE_MODEL_NAME=buffalo_sc

# ArcFace Cosine Distance threshold (0.45 recommended for balanced precision/recall)
FACE_MATCH_THRESHOLD=0.45

# Minimum detection confidence score (0.0 to 1.0)
FACE_DETECTION_CONFIDENCE=0.50

# Maximum photos returned per selfie search query
FACE_SEARCH_MAX_RESULTS=150

# ------------------------------------------------------------------------------
# 6. INGESTION, WATCH FOLDER & RATE LIMITING
# ------------------------------------------------------------------------------
# Legacy folder watcher toggle (false in cloud serverless; true if running local PC bridge)
ENABLE_WATCHER=false
WATCH_FOLDER=D:/WeddingPhotos

# Rate limiting throttles (Django REST Framework)
DEFAULT_THROTTLE_RATES_ANON=120/min
DEFAULT_THROTTLE_RATES_USER=1000/min
DEFAULT_THROTTLE_RATES_FACE_SEARCH=15/min
DEFAULT_THROTTLE_RATES_PHOTO_UPLOAD=120/min
DEFAULT_THROTTLE_RATES_PHOTOGRAPHER_LOGIN=10/min

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (VITE CLIENT BUNDLE)
# ------------------------------------------------------------------------------
# URL for HTTP API and WebSocket updates delivered to React client
VITE_API_BASE_URL=https://live-wedding-gallery.onrender.com/api
VITE_WS_BASE_URL=wss://live-wedding-gallery.onrender.com/ws
VITE_WEDDING_SLUG=sandeep-prathyusha
